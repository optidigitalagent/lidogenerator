# Скопируй этот файл в .env и заполни значения

# Токен Telegram-бота (получить у @BotFather)
TELEGRAM_TOKEN=
# Shadow mode remains the safe default; do not enable strict mode before controlled validation.
WEBSITE_RESOLVER_MODE=shadow

# Provider none means no paid/live website search. A zero request budget also disables it.
WEBSITE_SEARCH_PROVIDER=none
# Never commit a real Brave Search API key.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COUNTRY=UA
BRAVE_SEARCH_LANGUAGE=
BRAVE_SEARCH_UI_LANGUAGE=uk-UA
BRAVE_SEARCH_SAFESEARCH=moderate
BRAVE_SEARCH_MAX_RESULTS=5
BRAVE_SEARCH_TIMEOUT_SECONDS=10
MAX_WEBSITE_SEARCH_REQUESTS_PER_TASK=0

# OpenAI API is billed separately from ChatGPT.
# Keep disabled until controlled validation succeeds.
# Never commit a real key.
OPENAI_SCORING_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_SCORING_MAX_OUTPUT_TOKENS=256
OPENAI_SCORING_TIMEOUT_SECONDS=20

# Путь к базе SQLite (по умолчанию lead_hunter.db в папке проекта)
# DB_PATH=lead_hunter.db
